{
    "height": 28 , // Waybar height (to be removed for auto height)
    "position": "top",
    "modules-left": ["sway/workspaces", "sway/mode", "custom/weather"],
    "modules-center": ["sway/window"],
    //"idle_inhibitor","sway/language",
    "modules-right": [ "temperature",   "cpu", "memory", "disk", "battery", "network", "clock", "tray"],
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "0",
            "deactivated": "O"
        }
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "clock": {
        // "timezone": "China/Hong_Kong",
        //"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        //"format": " {:%a, %d %b, %H:%M:%S}"
        "format": "{:%a,%b.%d 󰃰 %H:%M:%S}",
        "format-alt": "{:%a.%b.%d}",
        "interval": 1
    },
    "pulseaudio": {
        "scroll-step": 1,
        "format": "Vol: {volume}%",
        "format-bluetooth": "Vol: {volume}% ",
        "format-bluetooth-muted": "Vol: {icon}",
        "format-muted": "Vol: {volume}%",
        "on-click": "pavucontrol"
    },
    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
       // "on-click": "kitty -e gdu /""interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "on-click": "kitty -e gdu /" 
    },
    "cpu": {
        "format": "󰻠 {usage}% ",
        "tooltip": true,
        "interval": 1,
        "on-click": "kitty -e htop"
    },
    "memory": {
        "format": "󰍛 {}%",
        "interval": 1,
        "on-click": "kitty -e htop"
    },
    "temperature": { 
        "critical-theshold": 80, 
        "format": "{icon}{temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],                                                                                        
        "on-click": "kitty -e s-tui"
    },
    "battery": {
        "format": "󱈑{capacity}%",
        "format-charging": "󰂄{capacity}%",
        "format-plugged": "󰂉 {capacity}%",
        "interval": 10
    },
    "network": {
        "format": "{ifname}󱚽 ",
        "tooltip-format": "{ipaddr}/{cidr}",
        "format-linked": "Network (No IP) via {ifname}",
        "format-disconnected": "󰯡 "
    },
"custom/weather": {
        "exec": "curl 'https://wttr.in/Shenzhen?format=1'",
        "interval": 3600,
        "format": "{}",
        "tooltip": true
    }
 //"custom/weather": {
        //"format": "{}",
        //"format-alt": "{alt}: {}",
        //"format-alt-click": "click-left",
        //"interval": 300,
        //"return-type": "json",
        // sleep before curl seems required because network might not yet be up
        // this avoids having to wait until interval until the indicator comes
        // back online
        //"exec": "sleep 5 && curl -s 'https://wttr.in/Shenzhen?format=1' | jq --unbuffered --compact-output -M -R '{text:.}'",
       // "exec-if": "ping wttr.in -c1",
       // "on-click-right": "kitty --start-as fullscreen bash -ci ~/bin/wttr"
    //}
}
